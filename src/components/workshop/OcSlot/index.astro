---
import ocPlaceholder from "@assets/workshop/oc-placeholder-sketch.svg";

interface Props {
	class?: string;
	src?: string;
	alt?: string;
	label?: string;
}

const { class: className, src, alt = "", label = "OC slot" } = Astro.props;
---

<figure class:list={["workshop-oc-slot", className]}>
	{src ? (
		<img src={src} alt={alt} loading="lazy" decoding="async" />
	) : (
		<img class="workshop-oc-fallback" src={ocPlaceholder.src} alt="" aria-hidden="true" />
	)}
	<figcaption>
		<strong>{label}</strong>
		<span>{src ? "Replaceable persona asset" : "Your future OC lives here"}</span>
	</figcaption>
</figure>
