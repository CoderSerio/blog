---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../../../config";
import { LinkPresets } from "../../../constants/link-presets";
import { isSupabaseConfigured } from "../../../lib/supabaseClient";
import { LinkPreset, type NavBarLink } from "../../../types/config";
import { url } from "../../../utils/url-utils";
import AuthMenu from "../../auth/AuthMenu/index.svelte";
import Search from "../../search/Search/index.svelte";
import DisplaySettings from "../../theme/DisplaySettings/index.svelte";
import LightDarkSwitch from "../../theme/LightDarkSwitch/index.svelte";
import NavMenuPanel from "./NavMenuPanel/index.astro";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<div id="navbar" class="z-50 onload-animation">
    <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div> <!-- used for onload animation -->
    <div class:list={[
        className,
        "card-base !overflow-visible max-w-[var(--page-width)] h-[4.5rem] !rounded-t-none mx-auto flex items-center justify-between px-4"]}>
        <a href={url('/')} class="btn-plain scale-animation rounded-lg h-[3.25rem] px-5 font-bold active:scale-95">
            <div class="flex flex-row text-[var(--primary)] items-center text-md">
                <Icon name="material-symbols:home-outline-rounded" class="text-[1.75rem] mb-1 mr-2" />
                {siteConfig.title}
            </div>
        </a>
        <div class="hidden md:flex">
            {links.map((l) => {
                return <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                          class="btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95"
                >
                    <div class="flex items-center">
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                    </div>
                </a>;
            })}
        </div>
        <div class="flex items-center">
            <div class="relative">
                <!-- Search keeps an SSR fallback because dev-time island hydration can intermittently fail. -->
                <div id="navbar-search-fallback-desktop" class="hidden lg:flex transition-all items-center h-11 mr-2 rounded-lg
                    bg-black/[0.04] hover:bg-black/[0.06] focus-within:bg-black/[0.06]
                    dark:bg-white/5 dark:hover:bg-white/10 dark:focus-within:bg-white/10">
                    <Icon name="material-symbols:search" class="absolute text-[1.25rem] pointer-events-none ml-3 transition my-auto text-black/30 dark:text-white/30"></Icon>
                    <input placeholder="Search" disabled class="transition-all pl-10 text-sm bg-transparent outline-0 h-full w-40 text-black/50 dark:text-white/50 cursor-default" />
                </div>
                <button id="navbar-search-fallback-mobile" aria-label="Search" class="btn-plain scale-animation lg:!hidden rounded-lg w-11 h-11 active:scale-90">
                    <Icon name="material-symbols:search" class="text-[1.25rem]"></Icon>
                </button>
                <Search client:only="svelte"></Search>
            </div>
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                    </button>
            )}
            <!-- Keep the theme fallback button in SSR output so the navbar does not lose this slot when hydration breaks. -->
            <button id="scheme-switch-fallback" aria-label="Light/Dark Mode" class="relative btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90">
                <Icon name="material-symbols:radio-button-partial-outline" class="text-[1.25rem]"></Icon>
            </button>
            <!-- client:load preserves the dropdown panel in SSR HTML; client:only made it disappear on Vite hydrate failures. -->
            <LightDarkSwitch client:load></LightDarkSwitch>
            {isSupabaseConfigured && (
                <>
                    <button id="navbar-auth-fallback" type="button" class="btn-plain scale-animation flex h-11 items-center rounded-lg px-4 font-bold active:scale-95">
                        Sign In
                    </button>
                    <!-- Auth also needs SSR output so cold-start hydration failures do not leave this slot empty. -->
                    <AuthMenu client:load></AuthMenu>
                </>
            )}
            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
        <!-- Same SSR reason as LightDarkSwitch: keep the panel rendered even if the Svelte island is late or broken. -->
        <DisplaySettings client:load></DisplaySettings>
    </div>
</div>

<script>
function switchTheme() {
    if (localStorage.theme === 'dark') {
        document.documentElement.classList.remove('dark');
        localStorage.theme = 'light';
    } else {
        document.documentElement.classList.add('dark');
        localStorage.theme = 'dark';
    }
}

function loadButtonScript() {
    let switchFallbackBtn = document.getElementById("scheme-switch-fallback");
    if (switchFallbackBtn) {
        switchFallbackBtn.onclick = function () {
            switchTheme()
        };
    }

    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let authFallbackBtn = document.getElementById("navbar-auth-fallback");
    if (authFallbackBtn) {
        authFallbackBtn.onclick = function () {
            window.dispatchEvent(new CustomEvent("blog-auth-open"));
        };
    }
}

function hideNavbarFallback(id: string) {
    const element = document.getElementById(id);
    if (element) {
        // Hide the static fallback only after the interactive island confirms it mounted correctly.
        element.style.display = "none";
    }
}

window.addEventListener("navbar-search-ready", function () {
    hideNavbarFallback("navbar-search-fallback-desktop");
    hideNavbarFallback("navbar-search-fallback-mobile");
});

window.addEventListener("navbar-scheme-ready", function () {
    hideNavbarFallback("scheme-switch-fallback");
});

window.addEventListener("navbar-auth-ready", function () {
    hideNavbarFallback("navbar-auth-fallback");
});

loadButtonScript();
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
