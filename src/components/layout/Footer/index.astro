---

import pawMark from "../../../assets/workshop/paw-mark.webp";
import { profileConfig } from "../../../config";
import { url } from "../../../utils/url-utils";

const currentYear = new Date().getFullYear();
---

<footer class="workshop-footer">
	<div>
		<strong>&copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}</strong>
		<span>Building the web, one artifact at a time.</span>
	</div>
	<nav aria-label="Footer navigation">
		<a href={url("rss.xml")}>RSS</a>
		<a href="https://github.com/CoderSerio" target="_blank" rel="noreferrer">GitHub</a>
		<a href={url("sitemap-index.xml")}>Sitemap</a>
	</nav>
	<div class="workshop-footer-stamp">
		<span>Ship with care</span>
		<img src={pawMark.src} alt="" aria-hidden="true" />
	</div>
</footer>
