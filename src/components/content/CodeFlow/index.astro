<script>
class CodeFlow extends HTMLElement {
	connectedCallback() {
		if (this.querySelector("dialog")) return;
		const figure = this.querySelector("figure");
		if (!figure) return;
		const dialog = document.createElement("dialog");
		dialog.setAttribute("aria-label", figure.querySelector("figcaption")?.textContent || "Diagram");
		const control = (label: string, action: () => void) => {
			const button = document.createElement("button");
			button.type = "button";
			button.textContent = label;
			button.addEventListener("click", action);
			return button;
		};
		let scale = 1;
		const zoom = (delta: number) => {
			scale = Math.min(2, Math.max(0.5, scale + delta));
			figure.style.zoom = String(scale);
		};
		const open = control("⛶", () => {
			dialog.append(figure);
			dialog.showModal();
			dialog.requestFullscreen?.().catch(() => {});
		});
		open.className = "mermaid-preview-button";
		open.ariaLabel = "Open diagram preview";
		open.title = "Preview diagram";
		const toolbar = document.createElement("div");
		toolbar.className = "flow-tools";
		toolbar.append(control("Zoom out", () => zoom(-0.25)), control("Zoom in", () => zoom(0.25)), control("Close", () => dialog.close()));
		dialog.append(toolbar);
		dialog.addEventListener("close", () => {
			this.prepend(figure);
			scale = 1;
			figure.style.removeProperty("zoom");
			open.focus();
		});
		this.append(open, dialog);
	}
}
if (!customElements.get("code-flow")) customElements.define("code-flow", CodeFlow);
</script>

