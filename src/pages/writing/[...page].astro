---
import LibraryTabs from "@components/archive/LibraryTabs/index.astro";
import type { GetStaticPaths } from "astro";
import { getSeriesForPost } from "@/content/series";
import Pagination from "../../components/archive/Pagination/index.astro";
import PostPage from "../../components/content/PostPage/index.astro";
import { PAGE_SIZE } from "../../constants/constants";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(
		allBlogPosts.filter((post) => !getSeriesForPost(post.slug)),
		{ pageSize: PAGE_SIZE },
	);
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;
---

<MainGridLayout>
    <LibraryTabs current="Posts" />
    <PostPage page={page}></PostPage>
    {page.lastPage > 1 && <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>}
</MainGridLayout>
