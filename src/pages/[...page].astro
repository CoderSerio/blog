---
import type { GetStaticPaths } from "astro";
import Pagination from "../components/archive/Pagination/index.astro";
import PostPage from "../components/content/PostPage/index.astro";
import WorkshopHome from "../components/workshop/Home/index.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;
const isFirstPage = page.currentPage === 1;
const hasMultiplePages = page.lastPage > 1;
---

<MainGridLayout>
    {isFirstPage ? <WorkshopHome entries={page.data} /> : <PostPage page={page} />}
    {hasMultiplePages && <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>}
</MainGridLayout>
